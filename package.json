{
    "name": "csr-boilerplate",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "pnpm run start:dev",
        "start:dev": "vite --config config/vite/index.ts --mode dev",
        "start:prod": "vite --config config/vite/index.ts --mode prod",
        "build:dev": "tsc -b && vite build --config config/vite/index.ts --mode dev",
        "build:prod": "tsc -b && vite build --config config/vite/index.ts --mode prod",
        "preview": "vite preview --config config/vite/index.ts",
        "test": "vitest --config config/vite/vitest.config.ts",
        "test:ui": "vitest --config config/vite/vitest.config.ts --ui",
        "test:coverage": "vitest run --config config/vite/vitest.config.ts --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@tailwindcss/vite": "^4.2.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.5",
        "@vitest/ui": "^4.1.5",
        "autoprefixer": "^10.5.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.8.3",
        "rollup-plugin-obfuscator": "^1.1.0",
        "sass": "^1.99.0",
        "tailwindcss": "^4.2.4",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-static-copy": "^4.1.0",
        "vitest": "^4.1.5"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.100.6",
        "axios": "^1.15.2",
        "axios-mock-adapter": "^2.1.0",
        "echarts": "^6.0.0",
        "echarts-for-react": "^3.0.6",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router": "^7.14.2",
        "zod": "^4.4.1",
        "zustand": "^5.0.13"
    },
    "volta": {
        "node": "24.15.0",
        "pnpm": "10.33.2"
    }
}
